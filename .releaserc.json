{
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [
          { "scope": "force-patch", "release": "patch" },
          { "scope": "no-release", "release": false },
          { "type": "docs", "subject": "say which trunks are limited to their major version", "release": false }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",    
    ["@semantic-release/changelog", 
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "echo \"newVersion=true\" >> $GITHUB_OUTPUT",
        "publishCmd": "echo \"version=${nextRelease.version}\" >> $GITHUB_OUTPUT && echo \"tag=${nextRelease.gitTag}\" >> $GITHUB_OUTPUT && echo \"type=${nextRelease.type}\" >> $GITHUB_OUTPUT && echo \"channel=${nextRelease.channel}\" >> $GITHUB_OUTPUT"
      }
    ]
  ],  
  "branches": [
    {"name": "essentials-1x", "range": "1.x", "channel": false},
    {"name": "essentials-2x", "range": "2.x", "channel": false},
    "essentials-3x",
    {
      "name": "replace-me-feature-branch",
      "prerelease": "replace-me-prerelease",
      "channel": "replace-me-prerelease"
    }
  ]
}